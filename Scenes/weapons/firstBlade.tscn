[sub_resource type="GDScript" id=8]
script/source = "extends Timer

func _ready():
	pass

func _on_Timer_timeout():
	get_parent().animationResetCooldown = true
	if(get_parent().attackAnimation == 1):
		get_parent().get_node(\"AnimationPlayer\").play(\"toIdleLeftAnimation\")
	elif(get_parent().attackAnimation == 0):
		get_parent().get_node(\"AnimationPlayer\").play(\"toIdleRightAnimation\")
	yield(get_tree().create_timer(0.2),\"timeout\")
	get_parent().animationResetCooldown = false
"

