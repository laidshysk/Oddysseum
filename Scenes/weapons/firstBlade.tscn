[sub_resource type="GDScript" id=1]
script/source = "extends Area2D

#AUTOLOAD GLOBALS DECLARED
#--------------------------------
var Globals : Dictionary
#--------------------------------

var damage : int
var isPicked : bool
var attackAnimation : int		# 0: attackLeftAnim		1: attackRightAnim
var animationResetCooldown : bool

func _ready():
	
	#AUTOLOAD GLOBALS INITIALIZED
	#--------------------------------
	Globals[\"GlobalBehaviour\"] = GlobalBehaviour
	Globals[\"GlobalBehaviour\"].initGlobals(self)
	#--------------------------------
	
	damage = 1
	isPicked = false
	attackAnimation = 0
	animationResetCooldown = false
	self.z_index = int(self.global_position.y)
	get_node(\"AnimationPlayer\").play(\"Iddle\")
	get_node(\"damageArea\").disabled = true
	
	Globals[\"GlobalSignalsEmitter\"].connect(\"item_picked\",self,\"_on_item_picked\")
	Globals[\"GlobalSignalsEmitter\"].connect(\"item_dropped\", self, \"_on_item_dropped\")

func _on_item_picked(_instance_id):
	if(_instance_id == self.get_instance_id()):
		isPicked = true

func _on_item_dropped():
	pass

func activateItem():
	if(not animationResetCooldown):
		get_node(\"Timer\").stop()
		get_node(\"Timer\").start()
		if(attackAnimation == 0):
			get_node(\"AnimationPlayer\").play(\"attackLeftAnimation\")
			attackAnimation = 1
		elif(attackAnimation == 1):
			get_node(\"AnimationPlayer\").play(\"attackRightAnimation\")
			attackAnimation = 0

func _on_Area2D_mouse_entered():
	Globals[\"GlobalSignalsEmitter\"].emit_signal(\"mouse_over\", self)

func _on_Area2D_mouse_exited():
	Globals[\"GlobalSignalsEmitter\"].emit_signal(\"mouse_exited\", self)
"

