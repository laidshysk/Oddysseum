resource_name = "playerBody"
script/source = "extends KinematicBody2D

# FATHER PLAYER (BODY) SCRIPT

#AUTOLOAD GLOBALS DECLARED
#--------------------------------
var Globals : Dictionary
#--------------------------------

const IDENTIFIER : String = \"PlayerBody\"
var health : int
var state : String
var velocity : int
var holdingItem : bool
var distanceToHoldingItem : int
var itemInHand

func _ready():
	
	#AUTOLOAD GLOBALS INITIALIZED
	#--------------------------------
	GlobalBehaviour.initGlobals(self)
	#--------------------------------
	
	Globals[\"GlobalBehaviour\"].initPlayer(self)
	
	health = 3 # hits
	state = \"Alive\"
	velocity = 45000 # ?
	holdingItem = false
	distanceToHoldingItem = 125 # px
	self.z_index = int(self.global_position.y)
	
	itemInHand = null
	

func _process(delta):
	movement(delta)
	hold_item()
	

func movement(delta):
	if(Globals[\"GlobalData\"].playerInputControl == true):
		var velocVector = Vector2(0,0)
		if(Globals[\"GlobalData\"].inputMap[\"PlayerUp\"]):
			velocVector.y += -1
		if(Globals[\"GlobalData\"].inputMap[\"PlayerDown\"]):
			velocVector.y += 1
		if(Globals[\"GlobalData\"].inputMap[\"PlayerLeft\"]):
			velocVector.x += -1
		if(Globals[\"GlobalData\"].inputMap[\"PlayerRight\"]):
			velocVector.x += 1
		move_and_slide(velocVector.normalized() * velocity * delta)
		self.z_index = int(self.global_position.y)

# Code functions for items
#------------------------------------
func _on_player_body_use_item():
	itemInHand.activateItem()

func _on_player_body_pick_item(_nodeUnderMouse):
	if(_nodeUnderMouse != null):
		if(_nodeUnderMouse.input_pickable):
			Globals[\"GlobalData\"].world.remove_child(_nodeUnderMouse)
			self.add_child(_nodeUnderMouse)
			itemInHand = _nodeUnderMouse
			holdingItem = true
			itemInHand.pickedSwitch()

func _on_player_body_drop_item():
	if(holdingItem):
		var aux
		if(cos(itemInHand.rotation_degrees * (PI/180)) >= 0):
			aux = 1
			itemInHand.rotation_degrees = 0
		else:
			aux = -1
			itemInHand.rotation_degrees = 180
		itemInHand.position = get_node(\"worldCollision\").global_position + Vector2(150 * aux,0)
		self.remove_child(itemInHand)
		Globals[\"GlobalData\"].world.add_child(itemInHand)
		itemInHand.pickedSwitch()
		holdingItem = false
		itemInHand = null

func hold_item():
	if(holdingItem):
		itemInHand.position = Vector2(0,0) + (Globals[\"GlobalData\"].playerSoul.vectorPlayerMouse.normalized() * distanceToHoldingItem)
		itemInHand.rotation_degrees = Globals[\"GlobalData\"].playerSoul.vectorPlayerMouse.angle() * (180/PI)
#------------------------------------

func _on_player_body_take_damage():
	health -= 1
	if(health < 1):
		Globals[\"GlobalData\"].playerInputControl = false
		state = \"Dead\"
		var position = get_node(\"worldCollision\").global_position
		get_node(\"Sprite\").rotate(deg2rad(90))
		self.global_position = position
		


"

[sub_resource type="GDScript" id=5]
script/source = "extends Node2D

# NODE SOUL SCRIPT

#AUTOLOAD GLOBALS DECLARED
#--------------------------------
var Globals : Dictionary
#--------------------------------

const IDENTIFIER : String = \"PlayerSoul\"
var vectorPlayerMouse : Vector2
var inPlayerReach : bool
var leftClick : bool
var rightClick : bool
var nodeUnderMouse
var overlappingNodes : Array

signal player_use_item
signal player_pick_item
signal player_drop_item

func _ready():
	
	#AUTOLOAD GLOBALS INITIALIZED
	#--------------------------------
	GlobalBehaviour.initGlobals(self)
	#--------------------------------
	
	Globals[\"GlobalBehaviour\"].initPlayer(self)
	
	inPlayerReach = false
	leftClick = false
	rightClick = false
	vectorPlayerMouse = Vector2(0,0)
	nodeUnderMouse = null
	overlappingNodes = []
	

func _process(_delta):
	getMouseVars()
	mouseInteractions()
	keyboardInteractions()


func getMouseVars():
	vectorPlayerMouse = Vector2(
		get_global_mouse_position().x - self.global_position.x,
		get_global_mouse_position().y - self.global_position.y)
	
	if(vectorPlayerMouse.length() <= 300):
		inPlayerReach = true
	else:
		inPlayerReach = false

func mouseInteractions():
	leftClick = Input.is_action_just_pressed(\"PlayerMouseLeftClick\")
	rightClick = Input.is_action_just_pressed(\"PlayerMouseRightClick\")
	
	if(Globals[\"GlobalData\"].playerInputControl):
		if(leftClick):
			if(Globals[\"GlobalData\"].playerBody.holdingItem):
				emit_signal(\"player_use_item\")
			elif(inPlayerReach):
				emit_signal(\"player_pick_item\", nodeUnderMouse)
				overlappingNodes.pop_back()
				if(overlappingNodes.size() == 0):
					nodeUnderMouse = null
				else:
					nodeUnderMouse = overlappingNodes.back()
			else:
				pass
		elif(rightClick):
			pass
		else:
			pass

func keyboardInteractions():
	if(Globals[\"GlobalData\"].playerInputControl):
		if(Globals[\"GlobalData\"].inputMap[\"DropItem\"]):
			emit_signal(\"player_drop_item\")

func _on_player_soul_mouse_over(node):
	Globals[\"GlobalBehaviour\"].insertOverlappingNode(overlappingNodes, node)
	nodeUnderMouse = overlappingNodes.back()

func _on_player_soul_mouse_exited(node):
	overlappingNodes.erase(node)
	if(overlappingNodes.size() > 0):
		nodeUnderMouse = overlappingNodes.back()
	else:
		nodeUnderMouse = null
"

