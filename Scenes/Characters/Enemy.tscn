[gd_scene load_steps=5 format=2]

[ext_resource path="res://Resources/Characters/Entities/EnemySpr.png" type="Texture" id=1]

[sub_resource type="GDScript" id=3]
resource_name = "Enemy"
script/source = "extends KinematicBody2D

const IDENTIFIER : String = \"Enemy\"
var health : int
var actMode : String
var distanceToPlayer : Vector2
var stalkDistance : int
var stalkDistanceArc : float	# ???
var stalkDirection : String

func _ready():
	health = 10
	actMode = \"Stalk\"
	distanceToPlayer = Vector2(0,0)
	stalkDistance = 300
	stalkDistanceArc = (1/3) * PI * stalkDistance

func _process(delta):
	getDistanceToPlayer()
	enemyAct(delta)

func getDistanceToPlayer():
	distanceToPlayer = GlobalData.playerBody.global_position - self.global_position

func enemyAct(delta):
	if(actMode == \"Stalk\"):
		enemyStalk(delta)
	elif(actMode == \"Attack\"):
		enemyAttack(delta)
	else:
		pass

func enemyStalk(_delta):
	var multiplier : int = 200
	var distanceToRadius : Vector2 = distanceToPlayer.normalized() * (distanceToPlayer.length() - stalkDistance)
	var walkDistance : Vector2
	var auxAngle
	if(stalkDirection == \"Left\"):
		auxAngle = -PI/2
	else:
		auxAngle = PI/2
	walkDistance = distanceToRadius + (distanceToRadius.normalized().rotated(auxAngle) * multiplier)
	move_and_slide(walkDistance,Vector2(0,0))

func enemyAttack(_delta):
	pass

func _on_stalkTimer_timeout():
	actMode = \"Attack\"
	get_node(\"attackTimer\").start()

func _on_attackTimer_timeout():
	actMode = \"Stalk\"
	get_node(\"stalkTimer\").start()

func _on_clickTimer_timeout():
	match randi() % 2:
		0:
			stalkDirection = \"Left\"
		1:
			stalkDirection = \"Right\"
"

