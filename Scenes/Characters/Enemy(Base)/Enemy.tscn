[ext_resource path="res://Resources/Characters/Entities/EnemySpr.png" type="Texture" id=1]

[sub_resource type="GDScript" id=3]
resource_name = "Enemy"
script/source = "extends KinematicBody2D

var Globals : Dictionary

#const IDENTIFIER : String = \"Enemy\"
var health : int
var actMode : String
var distanceToPlayer : Vector2
var stalkDistance : int
var stalkDistanceArc : float	# ???
var stalkDirection : String
var overlappingNodes : Array
var attackCooldown : bool

# Temporary attack mechanic
#----------------
var itemInHand
var attackDistance : int

func _ready():
	
	#AUTOLOAD GLOBALS INITIALIZED
	#--------------------------------
	GlobalBehaviour.initGlobals(self)
	#--------------------------------
	
	health = 10
	actMode = \"Stalk\"
	distanceToPlayer = Vector2(0,0)
	stalkDistance = 300
	stalkDistanceArc = (PI/3) * stalkDistance
	overlappingNodes = []
	attackCooldown = false
	
	itemInHand = null
	attackDistance = 80

func _process(delta):
	getDistanceToPlayer()
	
	if(itemInHand != null):
		itemInHand.global_position = self.position + distanceToPlayer.normalized() * attackDistance
	else:
		get_node(\"UnarmedCollision\").global_position = self.position + distanceToPlayer.normalized() * attackDistance
	enemyAct(delta)

func getDistanceToPlayer():
	distanceToPlayer = Globals[\"GlobalData\"].playerBody.global_position - self.global_position

func enemyAct(delta):
	if(actMode == \"Stalk\"):
		#enemyStalk(delta)
		pass
	elif(actMode == \"Attack\"):
		#enemyAttack(delta)
		pass
	else:
		pass

func enemyStalk(_delta):
	var multiplier : int = 200
	var distanceToRadius : Vector2 = distanceToPlayer.normalized() * (distanceToPlayer.length() - stalkDistance)
	var walkDistance : Vector2
	var auxAngle
	if(stalkDirection != \"None\"):
		if(stalkDirection == \"Left\"):
			auxAngle = -PI/2
		else:
			auxAngle = PI/2
		walkDistance = distanceToRadius + (distanceToRadius.normalized().rotated(auxAngle) * multiplier)
		move_and_slide(walkDistance,Vector2(0,0))

func enemyAttack(_delta):
	# Temporary attack mechanic
	#----------------
	if (distanceToPlayer.length() > attackDistance):
		move_and_slide(distanceToPlayer)
		print(distanceToPlayer.length())
	elif(!overlappingNodes.empty() and !attackCooldown):
		if (itemInHand != null):
			pass
		else:
			Globals[\"GlobalBehaviour\"].emit_signal(\"enemy_hit\", overlappingNodes)
			get_node(\"attackCooldownTimer\").start()
			attackCooldown = true
			print(\"attacked!\")
	#----------------

func _on_stalkTimer_timeout():
	actMode = \"Attack\"
	get_node(\"attackTimer\").start()

func _on_attackTimer_timeout():
	actMode = \"Stalk\"
	get_node(\"stalkTimer\").start()

func _on_clickTimer_timeout():
	match randi() % 3:
		0:
			stalkDirection = \"Left\"
		1:
			stalkDirection = \"Right\"
		2:
			stalkDirection = \"None\"

func _on_attackCooldownTimer_timeout():
	attackCooldown = false

func _on_unarmedCollision_area_entered(area):
	overlappingNodes.append(area.get_parent())
	print(\"added!\")
	print(area.get_parent())

func _on_unarmedCollision_area_exited(area):
	overlappingNodes.erase(area.get_parent())
	print(\"removed!\")
	print(area.get_parent())
"

