resource_name = "playerBody"
script/source = "extends KinematicBody2D

# FATHER PLAYER (BODY) SCRIPT

#AUTOLOAD GLOBALS DECLARED
#--------------------------------
var Globals : Dictionary
#--------------------------------

var health : int
var velocity : int
var holdingItem : bool
var distanceToHoldingItem : int
var itemInHand

func _ready():
	#AUTOLOAD GLOBALS INITIALIZED
	#--------------------------------
	Globals[\"GlobalBehaviour\"] = GlobalBehaviour
	print(Globals[\"GlobalBehaviour\"])
	Globals[\"GlobalBehaviour\"].initGlobals(self)
	#--------------------------------
	
	Globals[\"GlobalData\"].player = self
	health = 3 # hits
	velocity = 15000 # ?
	holdingItem = false
	distanceToHoldingItem = 125 # px
	self.z_index = int(self.global_position.y)
	
	itemInHand = null
	
	Globals[\"GlobalData\"].playerSoul.connect(\"player_use_item\",self,\"_on_soul_player_use_item\")
	Globals[\"GlobalData\"].playerSoul.connect(\"player_pick_item\",self,\"_on_soul_player_pick_item\")
	

func _process(delta):
	movement(delta)
	manage_item()
	

func movement(delta):
	if(Globals[\"GlobalData\"].playerSoul.control == true):
		var velocVector = Vector2(0,0)
		if(Globals[\"KeyboardInput\"].inputMap[\"PlayerUp\"]):
			velocVector.y += -1
		if(Globals[\"KeyboardInput\"].inputMap[\"PlayerDown\"]):
			velocVector.y += 1
		if(Globals[\"KeyboardInput\"].inputMap[\"PlayerLeft\"]):
			velocVector.x += -1
		if(Globals[\"KeyboardInput\"].inputMap[\"PlayerRight\"]):
			velocVector.x += 1
		move_and_slide(velocVector.normalized() * velocity * delta)
		self.z_index = int(self.global_position.y)

func _on_soul_player_use_item():
	itemInHand.activateItem()

func _on_soul_player_pick_item(_nodeUnderMouse):
	if(_nodeUnderMouse != null):
		if(_nodeUnderMouse.input_pickable):
			Globals[\"GlobalData\"].world.remove_child(_nodeUnderMouse)
			self.add_child(_nodeUnderMouse)
			itemInHand = _nodeUnderMouse
			holdingItem = true
			Globals[\"GlobalSignalsEmitter\"].emit_signal(\"item_picked\", _nodeUnderMouse.get_instance_id())

func manage_item():
	if(holdingItem):
		itemInHand.position = Vector2(0,0) + (Globals[\"GlobalData\"].playerSoul.vectorPlayerMouse.normalized() * distanceToHoldingItem)
		itemInHand.rotation_degrees = Globals[\"GlobalData\"].playerSoul.vectorPlayerMouse.angle() * (180/PI)




"

