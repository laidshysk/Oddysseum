[sub_resource type="GDScript" id=5]
script/source = "extends Node2D

# NODE SOUL SCRIPT

#AUTOLOAD GLOBALS DECLARED
#--------------------------------
var Globals : Dictionary
#--------------------------------

var control : bool
var vectorPlayerMouse : Vector2
var inPlayerReach : bool
var leftClick : bool
var rightClick : bool
var nodeUnderMouse

signal player_use_item
signal player_pick_item

func _ready():
	#AUTOLOAD GLOBALS INITIALIZED
	#--------------------------------
	Globals[\"GlobalBehaviour\"] = GlobalBehaviour
	Globals[\"GlobalBehaviour\"].initGlobals(self)
	#--------------------------------
	
	Globals[\"GlobalData\"].playerSoul = self
	control = Globals[\"GlobalControl\"].playerInputControl
	inPlayerReach = false
	leftClick = false
	rightClick = false
	vectorPlayerMouse = Vector2(0,0)
	nodeUnderMouse = null
	
	Globals[\"GlobalSignalsEmitter\"].connect(\"mouse_over\", self, \"_on_soul_mouse_over\")
	Globals[\"GlobalSignalsEmitter\"].connect(\"mouse_exited\", self, \"_on_soul_mouse_exited\")
	

func _process(_delta):
	getMouseVars()
	mouseInteractions()


func getMouseVars():
	vectorPlayerMouse = Vector2(
		get_global_mouse_position().x - self.global_position.x,
		get_global_mouse_position().y - self.global_position.y)
	
	if(vectorPlayerMouse.length() <= 300):
		inPlayerReach = true
	else:
		inPlayerReach = false
	
func mouseInteractions():
	leftClick = Input.is_action_just_pressed(\"PlayerMouseLeftClick\")
	rightClick = Input.is_action_just_pressed(\"PlayerMouseRightClick\")
	
	if(leftClick):
		if(Globals[\"GlobalData\"].player.holdingItem):
			emit_signal(\"player_use_item\")
		elif(inPlayerReach):
			emit_signal(\"player_pick_item\", nodeUnderMouse)
		else:
			pass
	elif(rightClick):
		pass
	else:
		pass

func _on_soul_mouse_over(_node):
	nodeUnderMouse = _node

func _on_soul_mouse_exited(_node):
	nodeUnderMouse = null
"

